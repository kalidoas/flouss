{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "customConditions": ["browser"],
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "react-router-dom": ["src/lib/react-router-dom.ts"],
      "firebase/auth": ["node_modules/@firebase/auth/dist/auth-public.d.ts"],
      "@firebase/auth": ["node_modules/@firebase/auth/dist/auth-public.d.ts"],
      "firebase/firestore": ["node_modules/@firebase/firestore/dist/index.d.ts"],
      "@firebase/firestore": ["node_modules/@firebase/firestore/dist/index.d.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
